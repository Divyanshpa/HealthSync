generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model patients {
  patient_id             Int       @id @default(autoincrement())
  phone_number           String    @db.VarChar(15)
  name                   String    @db.VarChar(100)
  dob                    DateTime  @db.Date
  sex                    String    @db.VarChar(10)
  address                String
  known_allergies        String[]  @default([])
  preexisting_conditions String[]  @default([])
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  uhid                   String?   @unique @db.VarChar(20)
  password_hash          String?   @db.VarChar(255)
}

model hospitals {
  hospital_id           Int                          @id @default(autoincrement())
  hospital_code         String?                      @unique @db.VarChar(25)
  name                  String                       @db.VarChar(150)
  license_number        String                       @unique @db.VarChar(50)
  type                  String                       @db.VarChar(50)
  email                 String                       @db.VarChar(100)
  phone                 String                       @db.VarChar(20)
  emergency_contact     String                       @db.VarChar(20)
  address               String
  city                  String                       @db.VarChar(50)
  state                 String                       @db.VarChar(50)
  pincode               String                       @db.VarChar(10)
  departments           String[]                     @default([])
  total_beds            Int                          @default(0)
  icu_beds              Int                          @default(0)
  ambulance_available   Boolean                      @default(false)
  admin_contact_name    String                       @db.VarChar(100)
  admin_contact_phone   String                       @db.VarChar(20)
  status                String                       @default("PENDING") @db.VarChar(20)
  rejection_reason      String?
  created_at            DateTime?                    @default(now()) @db.Timestamp(6)
  documents             hospital_documents[]
  verification_logs     hospital_verification_logs[]
}

model hospital_documents {
  document_id   Int       @id @default(autoincrement())
  hospital_id   Int
  document_type String    @db.VarChar(50)
  file_name     String    @db.VarChar(255)
  file_url      String
  file_size     String?   @db.VarChar(20)
  uploaded_at   DateTime? @default(now()) @db.Timestamp(6)
  hospital      hospitals @relation(fields: [hospital_id], references: [hospital_id], onDelete: Cascade)
}

model hospital_verification_logs {
  log_id             Int       @id @default(autoincrement())
  hospital_id        Int
  admin_email        String    @db.VarChar(100)
  action             String    @db.VarChar(20)
  license_verified   Boolean   @default(false)
  address_verified   Boolean   @default(false)
  safety_verified    Boolean   @default(false)
  verification_notes String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  hospital           hospitals @relation(fields: [hospital_id], references: [hospital_id], onDelete: Cascade)
}

model admin_users {
  admin_id      Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(100)
  password_hash String    @db.VarChar(255)
  name          String    @db.VarChar(100)
  role          String    @default("SUPER_ADMIN") @db.VarChar(50)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
}
